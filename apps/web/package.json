{
	"name": "forever-pto",
	"description": "The all-in-one tool to squish your valuable PTO days",
	"version": "1.8.3",
	"keywords": [
		"nextjs",
		"typescript",
		"css",
		"tailwind",
		"cloudflare",
		"pto",
		"time-off",
		"multi-language",
		"seo",
		"turbopack",
		"pnpm"
	],
	"author": "Ferran Buireu <contact@forever-pto.com>",
	"private": true,
	"license": "AGPL-3.0-only",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf:build": "opennextjs-cloudflare build",
		"deploy": "pnpm run cf:build && opennextjs-cloudflare deploy",
		"upload": "pnpm run cf:build && opennextjs-cloudflare upload",
		"bones:build": "boneyard-js build",
		"bones:watch": "boneyard-js build --watch",
		"cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"lint": "biome lint --no-errors-on-unmatched",
		"lint:all": "pnpm lint .",
		"lint:all:fix": "pnpm lint:all --fix",
		"lint:changed": "pnpm lint --write --changed",
		"format": "biome check --write --no-errors-on-unmatched",
		"format:all": "pnpm format .",
		"format:changed": "pnpm format --changed",
		"format:check": "biome check --no-errors-on-unmatched .",
		"typecheck": "tsc --project . --noEmit",
		"test:ut": "vitest run --logHeapUsage",
		"test:ut:watch": "vitest --logHeapUsage",
		"test:ut:coverage": "vitest run --coverage",
		"test:ut:changed": "pnpm test:ut --bail 1",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:changed": "playwright test --only-changed --pass-with-no-tests"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"@hookform/resolvers": "5.7.1",
		"@logtail/edge": "0.5.8",
		"@logtail/next": "0.4.0",
		"@opennextjs/cloudflare": "1.20.2",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.1.0",
		"@react-pdf/renderer": "4.6.0",
		"@stripe/react-stripe-js": "6.8.1",
		"@stripe/stripe-js": "9.13.0",
		"@tursodatabase/serverless": "1.4.0",
		"boneyard-js": "1.9.0",
		"canvas-confetti": "1.9.4",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"date-holidays": "3.34.1",
		"driver.js": "1.8.0",
		"effect": "3.22.1",
		"flag-icons": "7.5.0",
		"i18n-iso-countries": "7.14.0",
		"jose": "6.2.8",
		"lucide-react": "1.31.0",
		"motion": "13.1.0",
		"next": "16.2.12",
		"next-intl": "4.13.6",
		"next-themes": "0.4.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.85.0",
		"react-use-measure": "2.1.7",
		"recharts": "3.10.1",
		"resend": "6.19.0",
		"sonner": "2.0.8",
		"stripe": "22.5.0",
		"tailwind-merge": "3.6.0",
		"temporal-polyfill": "1.0.3",
		"vanilla-cookieconsent": "3.1.0",
		"vaul": "1.1.2",
		"zod": "4.4.3",
		"zustand": "5.0.14"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@tailwindcss/postcss": "4.3.3",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.3",
		"@types/canvas-confetti": "1.9.0",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"@vitest/coverage-v8": "4.1.10",
		"happy-dom": "20.11.2",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10",
		"wrangler": "4.121.0"
	}
}
