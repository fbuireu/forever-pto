{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "node_modules"],
	"compilerOptions": {
		"lib": ["ES2025", "DOM"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"skipLibCheck": true,
		"paths": {
			"@ui/*": ["../web/src/ui/*"]
		}
	}
}
