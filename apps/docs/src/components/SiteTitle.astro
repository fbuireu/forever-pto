---
import { Image } from "astro:assets";
import logo from "../assets/forever-pto-logo.png";
import { APP_VERSION } from "../lib/app-version";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="site-title-with-version">
  <a href={siteTitleHref} class="site-title" aria-label={siteTitle} translate="no">
    <span class="wordmark" aria-hidden="true">Forever</span>
    <span class="mark" aria-hidden="true">
      <Image src={logo} alt="" width={30} height={30} loading="eager" />
    </span>
  </a>
  <span class="app-version" title="Forever PTO app version">v{APP_VERSION}</span>
</div>

<style>
  .site-title-with-version {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--foreground);
    font-family: var(--font-bricolage), var(--sl-font);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .mark {
    display: block;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    background: var(--accent);
    border: 3px solid var(--frame);
    border-radius: 8px;
    box-shadow: var(--shadow-brutal-xs);
    overflow: hidden;
    transform: rotate(-4deg);
    transition: transform 150ms ease;
  }

  .mark :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .site-title:hover .mark {
    transform: rotate(0deg);
  }

  .app-version {
    flex-shrink: 0;
    background: var(--surface-panel);
    border: 2px solid var(--frame);
    border-radius: 999px;
    box-shadow: var(--shadow-brutal-xs);
    color: var(--foreground);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.35em 0.65em;
  }

  @media (max-width: 50rem) {
    .app-version {
      display: none;
    }
  }
</style>
