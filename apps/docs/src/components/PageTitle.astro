---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type SidebarEntry = StarlightRouteData["sidebar"][number];

interface TrailToParams {
	entries: SidebarEntry[];
	groups: string[];
}

const trailTo = ({ entries, groups }: TrailToParams): string[] | undefined => {
	for (const entry of entries) {
		if (entry.type === "link" && entry.isCurrent) return groups;
		if (entry.type === "group") {
			const found = trailTo({ entries: entry.entries, groups: [...groups, entry.label] });
			if (found) return found;
		}
	}
	return undefined;
};

const trail = trailTo({ entries: Astro.locals.starlightRoute.sidebar, groups: [] }) ?? [];
---

{trail.length > 0 && <p class="page-eyebrow">{trail.join(" · ")}</p>}
<Default />

<style>
  .page-eyebrow {
    color: var(--muted-foreground);
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-top: 1rem;
    text-transform: uppercase;
  }

  .page-eyebrow + :global(h1) {
    margin-top: 0.35rem;
  }
</style>
