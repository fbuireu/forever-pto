{
	"name": "forever-pto-monorepo",
	"description": "Monorepo for the Forever PTO app and its documentation site",
	"author": "Ferran Buireu <contact@forever-pto.com>",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": "26.7.0"
	},
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.0",
	"scripts": {
		"dev": "pnpm --filter forever-pto dev",
		"build": "pnpm --filter forever-pto build",
		"start": "pnpm --filter forever-pto start",
		"preview": "pnpm --filter forever-pto preview",
		"cf:build": "pnpm --filter forever-pto cf:build",
		"deploy": "pnpm --filter forever-pto deploy",
		"upload": "pnpm --filter forever-pto upload",
		"cf:typegen": "pnpm --filter forever-pto cf:typegen",
		"bones:build": "pnpm --filter forever-pto bones:build",
		"bones:watch": "pnpm --filter forever-pto bones:watch",
		"lint": "biome lint --no-errors-on-unmatched",
		"lint:all": "pnpm lint .",
		"lint:all:fix": "pnpm lint:all --fix",
		"lint:changed": "pnpm lint --write --changed",
		"format": "biome check --write --no-errors-on-unmatched",
		"format:all": "pnpm format .",
		"format:changed": "pnpm format --changed",
		"format:check": "biome check --no-errors-on-unmatched .",
		"typecheck": "tsc --project . --noEmit && pnpm --filter forever-pto typecheck && pnpm --filter forever-pto-docs typecheck",
		"test:ut": "pnpm --filter forever-pto test:ut && vitest run",
		"test:ut:watch": "vitest",
		"test:ut:coverage": "pnpm --filter forever-pto test:ut:coverage && vitest run --coverage",
		"test:ut:changed": "pnpm --filter forever-pto test:ut:changed",
		"test:docs": "vitest run",
		"test:e2e": "pnpm --filter forever-pto test:e2e",
		"test:e2e:ui": "pnpm --filter forever-pto test:e2e:ui",
		"verify": "pnpm format:check && pnpm typecheck && pnpm test:ut:coverage",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@commitlint/format": "21.2.0",
		"@commitlint/types": "21.2.0",
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/git": "11.0.1",
		"@semantic-release/npm": "13.1.5",
		"@types/node": "26.2.0",
		"@typescript/typescript6": "6.0.2",
		"@vitest/ui": "4.1.10",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"semantic-release": "25.0.9",
		"semantic-release-monorepo": "8.0.2",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
