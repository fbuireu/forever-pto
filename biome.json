{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": ["**", "!apps/web/next-env.d.ts"]
	},
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git",
		"defaultBranch": "main"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"lineWidth": 120,
		"indentStyle": "tab",
		"lineEnding": "lf"
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"includes": ["**", "!**/*.d.ts*"],
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noImportantStyles": "off"
			},
			"performance": {
				"noBarrelFile": "error",
				"noReExportAll": "error"
			},
			"style": {
				"noDefaultExport": "error"
			},
			"suspicious": {
				"noConsole": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.config.ts",
				"**/*.config.mjs",
				"**/apps/web/src/app/**/page.tsx",
				"**/apps/web/src/app/**/layout.tsx",
				"**/apps/web/src/app/**/loading.tsx",
				"**/apps/web/src/app/**/error.tsx",
				"**/apps/web/src/app/**/not-found.tsx",
				"**/apps/web/src/app/global-error.tsx",
				"**/apps/web/src/app/global-not-found.tsx",
				"**/apps/web/src/app/robots.ts",
				"**/apps/web/src/app/sitemap.ts",
				"**/apps/web/src/infrastructure/i18n/config.ts",
				"**/apps/web/e2e/warm-up.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": ["**/apps/web/src/infrastructure/logging/logger.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}
